# Base de datos (Postgres). Local con docker-compose, o una URL de Neon/Supabase/RDS.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cozizina?schema=public"

# Secreto para firmar los JWT de sesión. Generá uno real, mínimo 32 caracteres:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="cambiar-en-produccion-min-32-caracteres"

# URL pública de la app (para links en QR de mesas, emails, etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

NODE_ENV="development"

# Nivel de log: debug | info | warn | error
LOG_LEVEL="info"

# MercadoPago (opcional). Si lo dejás vacío, el cobro es solo-registro
# (efectivo / tarjeta en el posnet / transferencia). Con token, se
# habilita "Pagar con MercadoPago" desde la mesa.
MERCADOPAGO_ACCESS_TOKEN=""

# Código secreto del QR único para "pedir en el local" (salón sin QR
# por mesa: el cliente escanea este QR general y escribe su mesa o
# mozo). Es una variable de SERVIDOR (sin NEXT_PUBLIC_: esa se publicaba en el JavaScript del sitio).
# Generá uno propio:
#   node -e "console.log(require('crypto').randomBytes(9).toString('base64url'))"
QR_LOCAL_CODIGO="cambiar-en-produccion"


# Secreto de firma de los webhooks de MercadoPago (Tus integraciones → Webhooks → Clave secreta).
# Si está seteado, el webhook exige la cabecera x-signature válida. Recomendado en producción.
MERCADOPAGO_WEBHOOK_SECRET=

# Claves de la API pública /api/v1 (JSON). Vacío = la API responde 401 a todos.
# Ejemplo: {"<clave larga y al azar, 24+ caracteres>":{"tenantId":"<uuid>","scopes":["productos:leer"]}}
API_V1_KEYS=

# Token de instalación: único modo de crear el primer usuario de un restaurante vacío por /api/auth/register
# (header x-bootstrap-token). Mínimo 16 caracteres. Vacío = ese camino queda cerrado (el alta normal la hace
# scripts/nuevo-cliente).
BOOTSTRAP_TOKEN=

# Dominios desde los que se aceptan fotos externas en la carta (variable de BUILD), separados por coma:
#   fotos.mirestaurante.com, *.supabase.co
# Vacío = solo imágenes propias.
IMAGENES_HOSTS=

# Content-Security-Policy: vacío o "reporte" = solo registra violaciones; "bloquear" = las bloquea.
# Es variable de BUILD (hay que redeplegar). Ver docs/CSP-A-BLOQUEO.md antes de cambiarla.
CSP_MODO=

# 2FA obligatorio para el administrador: ya es obligatorio en producción; poné 1 para exigirlo también
# en otros entornos (pruebas, staging). Quien pierde el celular lo reinicia con
# `npx tsx scripts/nuevo-cliente/index.ts clave --email … --confirmo-base … --reiniciar-2fa si`.
ADMIN_2FA_OBLIGATORIO=
