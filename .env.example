# Base de datos (Postgres). Local con docker-compose, o una URL de Neon/Supabase/RDS.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cozizina?schema=public"

# Secreto para firmar los JWT de sesión. Generá uno real, mínimo 32 caracteres:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="cambiar-en-produccion-min-32-caracteres"

# URL pública de la app (para links en QR de mesas, emails, etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

NODE_ENV="development"

# Nivel de log: debug | info | warn | error
LOG_LEVEL="info"

# MercadoPago (opcional). Si lo dejás vacío, el cobro es solo-registro
# (efectivo / tarjeta en el posnet / transferencia). Con token, se
# habilita "Pagar con MercadoPago" desde la mesa.
MERCADOPAGO_ACCESS_TOKEN=""

# Código secreto del QR único para "pedir en el local" (salón sin QR
# por mesa: el cliente escanea este QR general y escribe su mesa o
# mozo). Generá uno propio:
#   node -e "console.log(require('crypto').randomBytes(9).toString('base64url'))"
NEXT_PUBLIC_QR_LOCAL_CODIGO="cambiar-en-produccion"

